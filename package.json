{
  "name": "kokoro-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf ./build && npm run openapigen && vite build",
    "build:static": "ADAPTER=static npm run build",
    "dev": "npm run openapigen && vite dev --host 0.0.0.0",
    "preview": "npm run openapigen && vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "openapigen": "node ./scripts/generate-openapi.mjs",
    "fmt": "prettier . --write",
    "test": "vitest run",
    "lint": "tsgo --noEmit"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "espeak-ng": "1.0.2",
    "fluent-ffmpeg": "2.1.3",
    "msw": "^2.12.7",
    "onnxruntime-node": "1.23.2",
    "onnxruntime-web": "1.23.2",
    "openai": "6.15.0",
    "wavefile": "11.0.0",
    "wavesurfer.js": "7.9.1",
    "zod": "4.3.4",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.4.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.17.1",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/vite": "4.0.6",
    "@types/fluent-ffmpeg": "2.1.28",
    "@typescript/native-preview": "^7.0.0-dev.20260103.1",
    "daisyui": "5.5.14",
    "lucide-svelte": "0.475.0",
    "prettier": "3.7.4",
    "prettier-plugin-svelte": "3.4.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "svelte": "5.46.1",
    "svelte-check": "4.3.5",
    "swagger-jsdoc": "6.2.8",
    "tailwindcss": "4.0.6",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vitest": "4.0.16",
    "wrangler": "3.110.0"
  },
  "msw": {
    "workerDirectory": [
      "static"
    ]
  }
}
